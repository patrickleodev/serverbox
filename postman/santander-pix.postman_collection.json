    {
      "name": "3. Create COB - R$ 1.00",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "if (!pm.environment.get('txid')) {",
              "  pm.environment.set('txid', `SB${Date.now()}POSTMANPIXTESTE`);",
              "}"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('COB request reached Santander', function () {",
              "  pm.expect(pm.response.code).to.be.oneOf([200, 201, 400, 401, 403, 404, 500]);",
              "});",
              "",
              "let json = {};",
              "try { json = pm.response.json(); } catch (error) {}",
              "console.log('COB response:', json || pm.response.text());",
              "",
              "if (pm.response.code === 200 || pm.response.code === 201) {",
              "  pm.test('COB created', function () {",
              "    pm.expect(json.txid || '').to.eql(pm.environment.get('txid'));",
              "  });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Accept",
            "value": "application/json, application/problem+json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          },
          {
            "key": "X-Application-Key",
            "value": "{{client_id}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"calendario\": {\n    \"expiracao\": 3600\n  },\n  \"devedor\": {\n    \"cnpj\": \"{{payer_tax_id}}\",\n    \"nome\": \"{{payer_name}}\"\n  },\n  \"valor\": {\n    \"original\": \"1.00\"\n  },\n  \"chave\": \"{{pix_key}}\",\n  \"solicitacaoPagador\": \"ServeBox teste {{txid}}\",\n  \"infoAdicionais\": [\n    {\n      \"nome\": \"Referencia\",\n      \"valor\": \"{{txid}}\"\n    },\n    {\n      \"nome\": \"Tipo\",\n      \"valor\": \"teste sandbox\"\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{api_base_url}}/cob/{{txid}}",
          "host": [
            "{{api_base_url}}"
          ],
          "path": [
            "cob",
            "{{txid}}"
          ]
        },
        "description": "Creates a dynamic Pix COB for R$ 1.00 using the access_token stored by one of the OAuth requests."
      },
      "response": []
