{
  "info": {
    "_postman_id": "fb1cc8eb-0f7d-4611-a0a8-9086eb13f997",
    "name": "ServeBox - Santander Pix",
    "description": "Santander Pix COB sandbox/production diagnostics. Import the environment template and configure the client certificate in Postman before running.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. OAuth - Documentation token URL",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "function decodeJwtPayload(token) {",
              "  const payload = token.split('.')[1];",
              "  const normalized = payload.replace(/-/g, '+').replace(/_/g, '/');",
              "  const padded = normalized.padEnd(normalized.length + (4 - normalized.length % 4) % 4, '=');",
              "  return JSON.parse(atob(padded));",
              "}",
              "",
              "pm.test('OAuth responded', function () {",
              "  pm.expect(pm.response.code).to.be.oneOf([200, 400, 401, 403]);",
              "});",
              "",
              "const json = pm.response.json();",
              "if (json.access_token) {",
              "  pm.environment.set('access_token', json.access_token);",
              "  const payload = decodeJwtPayload(json.access_token);",
              "  pm.environment.set('token_scope', payload.scope || '');",
              "  console.log('OAuth documentation token scope:', payload.scope);",
              "  pm.test('Token has cob.write', function () {",
              "    pm.expect(payload.scope || '').to.include('cob.write');",
              "  });",
              "} else {",
              "  console.log('OAuth documentation response:', json);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          },
          {
            "key": "client_id",
            "value": "{{client_id}}"
          },
          {
            "key": "client_secret",
            "value": "{{client_secret}}"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "client_id",
              "value": "{{client_id}}",
              "type": "text"
            },
            {
              "key": "client_secret",
              "value": "{{client_secret}}",
              "type": "text"
            },
            {
              "key": "grant_type",
              "value": "client_credentials",
              "type": "text"
            },
            {
              "key": "scope",
              "value": "cob.write",
              "type": "text"
            }
          ]
        },
        "url": {
          "raw": "{{auth_url_doc}}",
          "host": [
            "{{auth_url_doc}}"
          ]
        },
        "description": "Uses the Token URL displayed by the Santander API Pix technical documentation: /api/v1/oauth."
      },
      "response": []
    },
